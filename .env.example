# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
# Used automatically when OLLAMA_MODEL can't fit in memory (laptops):
OLLAMA_FALLBACK_MODEL=llama3.2:latest

# PhytoLens remote-sensing backend
REMOTE_SENSING_BASE_URL=https://remotesensing-backend-952153121532.us-central1.run.app
REMOTE_SENSING_API_KEY=your-key-here

# Embeddings (Ollama) — changing the model requires re-running `npm run index`
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Qdrant vector store
QDRANT_URL=http://localhost:6333
